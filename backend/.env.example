# Copie este arquivo para ".env" (mesma pasta) e preencha. NUNCA versionar o .env.
# Este arquivo é só um modelo: NÃO coloque valores reais aqui.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Gerar cada uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
SESSION_SECRET_KEY=
FRONTEND_URL=http://localhost:8000
INITIAL_ADMIN_EMAIL=seu.email@rjalimentos.com.br
# Opcional: restringe o login ao domínio da empresa
GOOGLE_ALLOWED_DOMAIN=rjalimentos.com.br
